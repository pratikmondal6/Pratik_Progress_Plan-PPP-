{
  "manifest_version": 3,
  "name": "PPP Activity Tracker",
  "short_name": "PPP Tracker",
  "version": "1.0.0",
  "description": "Privately tracks active website time by domain for Personal Progress Planner. Data stays on this Chrome profile.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PPP Activity Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pratikmondal6.github.io/Pratik_Progress_Plan-PPP-/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}