// PPP Shared Booking Service
// 1. Create a Google Sheet and open Extensions -> Apps Script.
// 2. Paste this file, run setupPPPBooking(), and copy the logged admin key.
// 3. Deploy as Web app: execute as yourself; access: anyone.
// 4. Paste the /exec URL and admin key into PPP Settings -> Shared booking connection.
const PPP_BOOKING_SHEET_NAME='Requests';
const PPP_BOOKING_HEADERS=['id','createdAt','name','email','type','what','date','time','timezone','duration','note','status','calendarEventId'];
const PPP_BOOKING_NOTIFICATION_EMAIL='pratikmondal.cs@gmail.com';

function doGet(e){
  const p=e&&e.parameter||{},action=String(p.action||'').toLowerCase();
  if(!action)return HtmlService.createHtmlOutput(publicBookingPage_(p)).setTitle('Book with Pratik').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  const callback=safeCallback_(p.callback);
  try{requireAdminKey_(p.key);let payload;if(action==='list')payload={ok:true,requests:listRequests_()};else if(action==='accept')payload={ok:true,request:updateRequestStatus_(p.id,'accepted')};else if(action==='decline')payload={ok:true,request:deleteRequest_(p.id)};else if(action==='emailstatus')payload={ok:true,email:bookingEmailDiagnostics_()};else if(action==='testemail')payload={ok:true,email:sendPPPBookingTestEmail_()};else if(action==='analyzediary')payload={ok:true,analysis:analyzeDiaryWithGemini_(p)};else payload={ok:false,error:'Unknown action'};return jsonOrJsonp_(payload,callback)}catch(error){return jsonOrJsonp_({ok:false,error:String(error&&error.message||error)},callback)}
}
function doPost(e){const p=e&&e.parameter||{},action=String(p.action||'').toLowerCase();if(action==='analyzediary'||action==='analyzeentry'){try{requireAdminKey_(p.key);return jsonResponse_({ok:true,analysis:action==='analyzeentry'?analyzeDiaryEntryWithGemini_(p):analyzeDiaryWithGemini_(p)})}catch(error){return jsonResponse_({ok:false,error:String(error&&error.message||error)})}}try{return HtmlService.createHtmlOutput(successPage_(createRequest_(p))).setTitle('Request sent')}catch(error){return HtmlService.createHtmlOutput(messagePage_('Could not send request',String(error&&error.message||error),'#ff5d6c')).setTitle('Could not send request')}}
function submitPublicBooking(payload){try{return {ok:true,request:createRequest_(payload||{})}}catch(error){return {ok:false,error:String(error&&error.message||error)}}}
function setupPPPBooking(notificationEmail){const properties=PropertiesService.getScriptProperties();if(!properties.getProperty('ADMIN_KEY'))properties.setProperty('ADMIN_KEY',Utilities.getUuid().replace(/-/g,''));const email=clean_(notificationEmail||PPP_BOOKING_NOTIFICATION_EMAIL||Session.getEffectiveUser().getEmail(),120);if(email)properties.setProperty('NOTIFICATION_EMAIL',email);const sheet=ensureSheet_(),spreadsheet=sheet.getParent(),quota=MailApp.getRemainingDailyQuota();Logger.log('ADMIN KEY: '+properties.getProperty('ADMIN_KEY'));Logger.log('NOTIFICATION EMAIL: '+(properties.getProperty('NOTIFICATION_EMAIL')||'Not set — run setPPPBookingNotificationEmail("you@example.com")'));Logger.log('MAIL QUOTA REMAINING: '+quota);Logger.log('BOOKING SPREADSHEET: '+spreadsheet.getUrl());Logger.log('Run testPPPBookingEmail() now. Then deploy a NEW web-app version and copy the /exec URL into PPP Settings.')}
function getPPPBookingAdminKey(){const key=PropertiesService.getScriptProperties().getProperty('ADMIN_KEY');if(!key)throw new Error('Run setupPPPBooking() first.');Logger.log(key);return key}
function setPPPBookingNotificationEmail(email){email=clean_(email,120);if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email))throw new Error('Enter a valid notification email address.');PropertiesService.getScriptProperties().setProperty('NOTIFICATION_EMAIL',email);Logger.log('Booking notifications will be sent to '+email);return email}
function bookingNotificationRecipient_(){const recipient=clean_(PropertiesService.getScriptProperties().getProperty('NOTIFICATION_EMAIL')||PPP_BOOKING_NOTIFICATION_EMAIL,120);if(!recipient||!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(recipient))throw new Error('Booking notification email is not configured. Run setPPPBookingNotificationEmail("you@example.com").');return recipient}
function maskedEmail_(email){const parts=String(email||'').split('@');if(parts.length!==2)return '';const name=parts[0],visible=name.slice(0,Math.min(2,name.length));return visible+'***@'+parts[1]}
function bookingEmailDiagnostics_(){const recipient=bookingNotificationRecipient_(),quota=MailApp.getRemainingDailyQuota();return {configured:true,recipient:maskedEmail_(recipient),remainingDailyQuota:quota,scriptTimezone:Session.getScriptTimeZone()||'',effectiveUser:maskedEmail_(Session.getEffectiveUser().getEmail()||'')}}
function sendPPPBookingTestEmail_(){const recipient=bookingNotificationRecipient_(),quota=MailApp.getRemainingDailyQuota();if(quota<1)throw new Error('Apps Script email quota is exhausted for today.');const stamp=Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'Europe/Berlin','yyyy-MM-dd HH:mm:ss z');MailApp.sendEmail({to:recipient,subject:'PPP booking email test',body:'PPP booking email is working. Test sent at '+stamp+'.\n\nIf you received this message, owner notifications can be sent from the current Apps Script deployment.',htmlBody:'<div style="font-family:Arial,sans-serif;line-height:1.6"><h2>✅ PPP booking email is working</h2><p>This test was sent at <strong>'+escapeHtml_(stamp)+'</strong>.</p><p>If you received this message, owner notifications can be sent from the current Apps Script project.</p></div>',name:'PPP Booking'});return {sent:true,recipient:maskedEmail_(recipient),remainingDailyQuota:MailApp.getRemainingDailyQuota(),sentAt:new Date().toISOString()}}
function testPPPBookingEmail(){const result=sendPPPBookingTestEmail_();Logger.log(JSON.stringify(result));return result}
function setGeminiApiKey(apiKey){apiKey=clean_(apiKey,300);if(!apiKey)throw new Error('Enter a Gemini API key.');PropertiesService.getScriptProperties().setProperty('GEMINI_API_KEY',apiKey);Logger.log('Gemini API key saved securely in Script Properties.');return true}
function setGeminiModel(model){model=clean_(model,80);if(!/^[a-zA-Z0-9._-]+$/.test(model))throw new Error('Invalid Gemini model name.');PropertiesService.getScriptProperties().setProperty('GEMINI_MODEL',model);return model}
function analyzeDiaryWithGemini_(p){
  const properties=PropertiesService.getScriptProperties(),apiKey=properties.getProperty('GEMINI_API_KEY');if(!apiKey)throw new Error('Gemini is not configured. Run setGeminiApiKey("YOUR_KEY") in Apps Script.');
  const scope=clean_(p.scope||'day',20),text=clean_(p.text,50000);if(!text)throw new Error('Diary text is required.');
  const model=properties.getProperty('GEMINI_MODEL')||'gemini-2.5-flash',prompt='Act as a practical personal consistency coach and analyze these diary entries as a '+scope+' life and progress review. Cover lifestyle, sleep, work/study, relationships, mood, problems, goals, and habit patterns when supported by the writing. Interpret intentional avoidance correctly: statements such as "I did not scroll Facebook for 15 days" or "I did not watch pornography" describe positive self-control and an achievement, not a failed task. Praise specific effective behavior, identify negative patterns honestly, and turn broad goals into repeatable habits. Recommendations should favor one priority, a small minimum action, a reliable cue, environment design, tracking, and a recovery rule after missed days. If pornography use, compulsive sexual behavior, or another addiction-like habit is mentioned, discuss possible triggers, positive progress, negative effects, and realistic harm-reduction or recovery steps without shame, moral judgment, or explicit sexual detail. Do not diagnose addiction or any mental-health condition. Do not invent facts. Encourage qualified professional support when the writing suggests severe distress, loss of control, danger, or major impairment. Return ONLY valid JSON with this exact shape: {"overview":"short outcome title","summary":"concise overall assessment","goals":["goals or intentions"],"achievements":["completed work or wins"],"lifestyle":["lifestyle observations"],"positives":["positive events, feelings, or behaviors"],"negatives":["negative effects or behaviors"],"obstacles":["problems, unfinished tasks, or difficulties"],"habitPatterns":["compulsive habit patterns or progress"],"triggers":["possible triggers explicitly supported by entries"],"patterns":["useful recurring patterns"],"nextSteps":["small, specific habit-building actions including cue and minimum when possible"],"supportNote":"brief safety or professional-support note only when warranted, otherwise empty"}. Use at most 5 short items per list.\nDiary entries:\n'+text;
  const response=UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/'+encodeURIComponent(model)+':generateContent?key='+encodeURIComponent(apiKey),{method:'post',contentType:'application/json',muteHttpExceptions:true,payload:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0.35,responseMimeType:'application/json'}})}),status=response.getResponseCode(),body=response.getContentText();if(status<200||status>=300)throw new Error('Gemini request failed ('+status+'): '+body.slice(0,300));
  const data=JSON.parse(body),raw=data.candidates&&data.candidates[0]&&data.candidates[0].content&&data.candidates[0].content.parts&&data.candidates[0].content.parts[0]&&data.candidates[0].content.parts[0].text;if(!raw)throw new Error('Gemini returned no analysis.');const analysis=JSON.parse(String(raw).replace(/^```json\s*|\s*```$/g,'')),result={overview:clean_(analysis.overview,160),summary:clean_(analysis.summary,900),supportNote:clean_(analysis.supportNote,500)};['goals','achievements','lifestyle','positives','negatives','obstacles','habitPatterns','triggers','patterns','nextSteps'].forEach(function(key){result[key]=(Array.isArray(analysis[key])?analysis[key]:[]).map(function(x){return clean_(x,240)}).filter(Boolean).slice(0,5)});return result
}
function analyzeDiaryEntryWithGemini_(p){
  const properties=PropertiesService.getScriptProperties(),apiKey=properties.getProperty('GEMINI_API_KEY');if(!apiKey)throw new Error('Gemini is not configured. Add GEMINI_API_KEY in Apps Script Properties.');const title=clean_(p.title,120),text=clean_(p.text,10000),type=clean_(p.type,30),createdAt=clean_(p.createdAt,40),goals=clean_(p.goals,3500);if(!text)throw new Error('Diary text is required.');
  const model=properties.getProperty('GEMINI_MODEL')||'gemini-2.5-flash',prompt='Interpret this single diary entry as a personal consistency coach. Understand meaning from context; do not use simplistic keyword rules. Intentional avoidance such as not scrolling Facebook or not watching pornography is positive progress, while not completing a desired task is an obstacle. Extract only outcomes clearly supported by the text. The website may apply your structured actions to its planner, so be conservative. Goal definitions: '+goals+'\nReturn ONLY valid JSON: {"sentiment":"positive|negative|neutral","summary":"concise interpretation","insights":["up to 4"],"suggestions":["up to 4 small next steps"],"actions":[{"field":"one exact goal key from definitions OR notes OR commitment OR schedulePreference","value":"for goal: minutes number; for notes: short text; for commitment: {date:YYYY-MM-DD,start:minutesAfterMidnight,end:minutesAfterMidnight,title:string}; for schedulePreference: {date:YYYY-MM-DD,wake:minutesAfterMidnight,sleep:minutesAfterMidnight}","label":"human-readable outcome"}]}. Never invent minutes, dates, times, completion, or relapse. If no planner update is explicit, return an empty actions array. Do not diagnose medical or mental-health conditions.\nEntry timestamp: '+createdAt+'\nEntry type: '+type+'\nTitle: '+title+'\nText: '+text;
  const response=UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/'+encodeURIComponent(model)+':generateContent?key='+encodeURIComponent(apiKey),{method:'post',contentType:'application/json',muteHttpExceptions:true,payload:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0.2,responseMimeType:'application/json'}})}),status=response.getResponseCode(),body=response.getContentText();if(status<200||status>=300)throw new Error('Gemini request failed ('+status+'): '+body.slice(0,300));const data=JSON.parse(body),raw=data.candidates&&data.candidates[0]&&data.candidates[0].content&&data.candidates[0].content.parts&&data.candidates[0].content.parts[0]&&data.candidates[0].content.parts[0].text;if(!raw)throw new Error('Gemini returned no analysis.');const analysis=JSON.parse(String(raw).replace(/^```json\s*|\s*```$/g,''));return {sentiment:['positive','negative','neutral'].indexOf(analysis.sentiment)>=0?analysis.sentiment:'neutral',summary:clean_(analysis.summary,700),insights:(Array.isArray(analysis.insights)?analysis.insights:[]).map(function(x){return clean_(x,220)}).filter(Boolean).slice(0,4),suggestions:(Array.isArray(analysis.suggestions)?analysis.suggestions:[]).map(function(x){return clean_(x,220)}).filter(Boolean).slice(0,4),actions:Array.isArray(analysis.actions)?analysis.actions.slice(0,8):[]}
}
function requireAdminKey_(key){const expected=PropertiesService.getScriptProperties().getProperty('ADMIN_KEY');if(!expected)throw new Error('Run setupPPPBooking() first.');if(String(key||'')!==expected)throw new Error('Invalid admin key.')}
function bookingSpreadsheet_(){
  const properties=PropertiesService.getScriptProperties(),active=SpreadsheetApp.getActiveSpreadsheet();if(active){properties.setProperty('SPREADSHEET_ID',active.getId());return active}
  const savedId=properties.getProperty('SPREADSHEET_ID');if(savedId){try{return SpreadsheetApp.openById(savedId)}catch(error){console.warn('Saved booking spreadsheet could not be opened; creating a new one.')}}
  const created=SpreadsheetApp.create('PPP Booking Requests');properties.setProperty('SPREADSHEET_ID',created.getId());return created
}
function setPPPBookingSpreadsheetId(id){id=clean_(id,200).replace(/^.*\/spreadsheets\/d\/([^/]+).*$/,'$1');if(!id)throw new Error('Enter a Google Sheet ID or URL.');const spreadsheet=SpreadsheetApp.openById(id);PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',spreadsheet.getId());ensureSheet_();Logger.log('Booking spreadsheet set to '+spreadsheet.getUrl());return spreadsheet.getUrl()}
function ensureSheet_(){const spreadsheet=bookingSpreadsheet_();let sheet=spreadsheet.getSheetByName(PPP_BOOKING_SHEET_NAME);if(!sheet)sheet=spreadsheet.insertSheet(PPP_BOOKING_SHEET_NAME);if(sheet.getLastRow()===0)sheet.appendRow(PPP_BOOKING_HEADERS);sheet.getRange(2,7,Math.max(1,sheet.getMaxRows()-1),3).setNumberFormat('@');return sheet}
function clean_(value,max){return String(value==null?'':value).trim().slice(0,max)}
function storedBookingTime_(value){if(value instanceof Date&&!isNaN(value.getTime()))return String(value.getHours()).padStart(2,'0')+':'+String(value.getMinutes()).padStart(2,'0');const text=String(value==null?'':value),iso=text.match(/T([01]\d|2[0-3]):([0-5]\d)/);return iso?iso[1]+':'+iso[2]:normalizeBookingTime_(text)}
function normalizeBookingTime_(raw){let value=String(raw==null?'':raw).trim().toLowerCase().replace(/\./g,'').replace(/\s+/g,''),period='';const suffix=value.match(/(am|pm)$/);if(suffix){period=suffix[1];value=value.slice(0,-2)}let hours,minutes;if(value.indexOf(':')>=0){const parts=value.split(':');hours=Number(parts[0]);minutes=Number(parts[1])}else{const digits=value.replace(/\D/g,'');if(!digits||digits.length>4)return '';if(digits.length<=2){hours=Number(digits);minutes=0}else if(digits.length===3){hours=Number(digits.slice(0,1));minutes=Number(digits.slice(1))}else{hours=Number(digits.slice(0,2));minutes=Number(digits.slice(2))}}if(!Number.isInteger(hours)||!Number.isInteger(minutes)||minutes<0||minutes>59)return '';if(period){if(hours<1||hours>12)return '';if(period==='am')hours=hours===12?0:hours;else hours=hours===12?12:hours+12}if(hours<0||hours>23)return '';return String(hours).padStart(2,'0')+':'+String(minutes).padStart(2,'0')}
function createRequest_(p){
  const name=clean_(p.name,80),email=clean_(p.email,120),type=clean_(p.type||'Appointment',50),what=clean_(p.what,140),date=clean_(p.date,10),time=normalizeBookingTime_(p.time),timezone=clean_(p.timezone||Session.getScriptTimeZone()||'Europe/Berlin',80),duration=Math.max(15,Math.min(240,Number(p.duration)||30)),note=clean_(p.note,500);
  if(!name)throw new Error('Please enter your name.');if(email&&!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email))throw new Error('Please enter a valid email.');if(!what)throw new Error('Please say what the booking is for.');if(!/^\d{4}-\d{2}-\d{2}$/.test(date))throw new Error('Please choose a date.');if(!time)throw new Error('Please enter a valid time.');
  const row=['req_'+Utilities.getUuid().slice(0,8)+'_'+Date.now(),new Date().toISOString(),name,email,type,what,date,time,timezone,duration,note,'pending',''];ensureSheet_().appendRow(row);const request=rowToObject_(row);request.notificationSent=false;request.confirmationSent=false;
  try{const ownerResult=notifyBookingOwner_(request);request.notificationSent=Boolean(ownerResult&&ownerResult.sent)}catch(error){console.error('Booking saved, but owner notification failed: '+String(error&&error.message||error));request.notificationError=String(error&&error.message||error)}
  if(request.email){try{const visitorResult=sendBookingVisitorConfirmation_(request);request.confirmationSent=Boolean(visitorResult&&visitorResult.sent)}catch(error){console.error('Booking saved, but visitor confirmation failed: '+String(error&&error.message||error));request.confirmationError=String(error&&error.message||error)}}
  return request;
}
function notifyBookingOwner_(request){
  const recipient=bookingNotificationRecipient_(),quota=MailApp.getRemainingDailyQuota();if(quota<1)throw new Error('Apps Script email quota is exhausted for today.');const owner=bookingWithOwnerTime_(request);
  const subject='New booking request: '+request.what+' — '+request.date+' '+request.time;
  const lines=['You received a new PPP booking request.','',
    'Name: '+request.name,
    request.email?'Email: '+request.email:'Email: Not provided',
    'Purpose: '+request.what,
    'Type: '+request.type,
    'Date: '+request.date,
    'Time: '+request.time+' ('+request.timezone+')',
    owner.ownerTime?'Germany time: '+owner.ownerDate+' '+owner.ownerTime+' ('+owner.ownerTimezone+')':'',
    'Duration: '+request.duration+' minutes',
    request.note?'Message: '+request.note:'Message: None','',
    'Open your PPP Booking Dashboard to accept or decline it.'
  ];
  const options={to:recipient,subject:subject,body:lines.join('\n'),htmlBody:'<div style="font-family:Arial,sans-serif;line-height:1.6;color:#17213a"><h2>📅 New booking request</h2><p><strong>'+escapeHtml_(request.what)+'</strong></p><table cellpadding="5" cellspacing="0"><tr><td><b>Name</b></td><td>'+escapeHtml_(request.name)+'</td></tr><tr><td><b>Email</b></td><td>'+escapeHtml_(request.email||'Not provided')+'</td></tr><tr><td><b>Visitor time</b></td><td>'+escapeHtml_(request.date+' '+request.time+' ('+request.timezone+')')+'</td></tr><tr><td><b>Germany time</b></td><td>'+escapeHtml_(owner.ownerTime?(owner.ownerDate+' '+owner.ownerTime+' ('+owner.ownerTimezone+')'):'Unavailable')+'</td></tr><tr><td><b>Duration</b></td><td>'+escapeHtml_(request.duration+' minutes')+'</td></tr><tr><td><b>Message</b></td><td>'+escapeHtml_(request.note||'None')+'</td></tr></table><p>Open PPP → Bookings to accept or decline.</p></div>',name:'PPP Booking'};if(request.email)options.replyTo=request.email;MailApp.sendEmail(options);return {sent:true,recipient:maskedEmail_(recipient)};
}
function sendBookingVisitorConfirmation_(request){const recipient=clean_(request.email,120);if(!recipient)return {sent:false};if(MailApp.getRemainingDailyQuota()<1)throw new Error('Apps Script email quota is exhausted before visitor confirmation could be sent.');const owner=bookingWithOwnerTime_(request),subject='Your booking request with Pratik was received',body=['Hi '+request.name+',','','Your booking request has been received.','Purpose: '+request.what,'Date: '+request.date,'Time: '+request.time+' ('+request.timezone+')','Duration: '+request.duration+' minutes','','This is a request, not a final confirmation yet. You will receive a Google Calendar invitation if it is accepted.'].join('\n');MailApp.sendEmail({to:recipient,subject:subject,body:body,htmlBody:'<div style="font-family:Arial,sans-serif;line-height:1.6;color:#17213a"><h2>✅ Booking request received</h2><p>Hi '+escapeHtml_(request.name)+',</p><p>Your request for <strong>'+escapeHtml_(request.what)+'</strong> was received.</p><p><b>Your time:</b> '+escapeHtml_(request.date+' '+request.time+' ('+request.timezone+')')+'<br><b>Duration:</b> '+escapeHtml_(request.duration+' minutes')+'</p><p><strong>This is not the final confirmation yet.</strong> If the request is accepted, you will receive a Google Calendar invitation.</p></div>',name:'PPP Booking'});return {sent:true,recipient:maskedEmail_(recipient),ownerTime:owner.ownerTime||''}}
function bookingWithOwnerTime_(request){try{const instant=bookingDateTime_(String(request.date).slice(0,10),request.time,request.timezone),ownerTimezone=Session.getScriptTimeZone()||'Europe/Berlin';return Object.assign({},request,{ownerDate:Utilities.formatDate(instant,ownerTimezone,'yyyy-MM-dd'),ownerTime:Utilities.formatDate(instant,ownerTimezone,'HH:mm'),ownerTimezone:ownerTimezone})}catch(error){return request}}
function listRequests_(){const values=ensureSheet_().getDataRange().getValues();return values.length<=1?[]:values.slice(1).map(rowToObject_).filter(function(request){return request.id}).map(bookingWithOwnerTime_).sort(function(a,b){return String(b.createdAt).localeCompare(String(a.createdAt))})}
function rowToObject_(row){const object={};PPP_BOOKING_HEADERS.forEach(function(header,index){object[header]=header==='time'?storedBookingTime_(row[index]):row[index] instanceof Date?row[index].toISOString():row[index]});return object}
function bookingDateTime_(date,time,timezone){const normalized=storedBookingTime_(time);if(!normalized)throw new Error('Invalid booking time: '+time);return Utilities.parseDate(date+' '+normalized,timezone||Session.getScriptTimeZone(),'yyyy-MM-dd HH:mm')}
function updateRequestStatus_(id,status){const sheet=ensureSheet_(),values=sheet.getDataRange().getValues();for(let index=1;index<values.length;index++){if(String(values[index][0])!==String(id))continue;const row=values[index];row[11]=status;if(status==='accepted'&&!row[12]){const start=bookingDateTime_(String(row[6]).slice(0,10),normalizeBookingTime_(row[7]),row[8]),end=new Date(start.getTime()+(Number(row[9])||30)*60000),description=['Requested by: '+row[2],row[3]?'Email: '+row[3]:'','Type: '+row[4],'Visitor time: '+row[6]+' '+row[7]+' ('+row[8]+')',row[10]?'Note: '+row[10]:'','PPP request: '+row[0]].filter(Boolean).join('\n'),options={description:description};if(row[3]){options.guests=row[3];options.sendInvites=true}const event=CalendarApp.getDefaultCalendar().createEvent(row[5]||row[4],start,end,options);row[12]=event.getId()}sheet.getRange(index+1,1,1,PPP_BOOKING_HEADERS.length).setValues([row]);return bookingWithOwnerTime_(rowToObject_(row))}throw new Error('Request not found.')}
function deleteRequest_(id){const sheet=ensureSheet_(),values=sheet.getDataRange().getValues();for(let index=1;index<values.length;index++){if(String(values[index][0])===String(id)){sheet.deleteRow(index+1);return {id:id,deleted:true}}}throw new Error('Request not found.')}
function safeCallback_(value){const callback=String(value||'');return /^[A-Za-z_$][0-9A-Za-z_$\.]*$/.test(callback)?callback:''}
function jsonOrJsonp_(payload,callback){const json=JSON.stringify(payload);return ContentService.createTextOutput(callback?callback+'('+json+');':json).setMimeType(ContentService.MimeType.JAVASCRIPT)}
function jsonResponse_(payload){return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(ContentService.MimeType.JSON)}
function escapeHtml_(value){return String(value==null?'':value).replace(/[&<>"']/g,function(character){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]})}
function publicBookingPage_(prefill){
